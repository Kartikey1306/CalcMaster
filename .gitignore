node_modules/
*.log
.env

# Flutter/Dart build artifacts
build/
.dart_tool/
.flutter-plugins-dependencies

# Signing & store credentials — never commit
*.p8
*.p12
# sigh/get_provisioning_profile drops the fetched profile in the repo root
*.mobileprovision
fastlane/play-service-account.json
fastlane/report.xml

# Generated by macOS system Bundler 1.17.2 (pins BUNDLED WITH 1.17.2, which
# crashes under CI's Ruby 3.3). Let CI resolve fresh instead of shipping it.
Gemfile.lock
upload_certificate.pem

# Real secrets for internal builds — never commit
env/secrets.json

# Android signing material — the upload key and its plaintext passwords.
# Tracked by mistake until now; the key they protect still needs a Play
# Console upload-key reset because it is recoverable from git history.
android/key.properties
android/*.jks
android/*.keystore

# ── Signing and delivery secrets — never commit ──────────────────────────────
# An upload keystore in git is unrecoverable: the key is public from the moment
# it is pushed, and with Play App Signing off the listing can never be updated
# again. The Firebase config files are deliberately NOT here — Google documents
# them as non-secret, they ship inside the binary anyway, and CI needs them in
# the checkout for the Crashlytics Gradle plugin to apply and upload a mapping.
**/key.properties
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision
*.cer
**/fastlane/play-service-account.json
**/fastlane/*.json.enc
env/*.json
!env/*.example.json
!env/example.json
